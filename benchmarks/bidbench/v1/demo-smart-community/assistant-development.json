      "expected_mode": "tool_action",
      "expected_tool_name": "export_deliverable",
      "required_argument_keys": ["deliverable_id", "format"],
      "expected_policy_outcome": "require_approval",
      "expected_typed_confirmation": false
    },
    {
      "id": "export-without-deliverable",
      "message": "导出当前交付物",
      "approval_mode": "risky_only",
      "expected_mode": "needs_input",
      "expected_tool_name": "export_deliverable",
      "expected_missing_fields": ["deliverable_id"]
    },
    {
      "id": "requirements-without-project",
      "message": "查看项目需求",
      "approval_mode": "risky_only",
      "expected_mode": "needs_input",
      "expected_tool_name": "list_requirements",
      "expected_missing_fields": ["project_id"],
      "expect_project_scope": true
    },
    {
      "id": "open-provider-settings",
      "message": "打开供应商设置页面",
      "approval_mode": "risky_only",
      "expected_mode": "tool_action",
      "expected_tool_name": "open_page",
