DOCPILOT_POSTGRES_DB=bidpilot
DOCPILOT_POSTGRES_USER=bidpilot
DOCPILOT_POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode the database password if it contains reserved URL characters.
DOCPILOT_DATABASE_URL=postgresql+psycopg://bidpilot:replace-with-url-encoded-password@postgres:5432/bidpilot
DOCPILOT_REDIS_PASSWORD=replace-with-a-long-random-redis-password
# URL-encode the Redis password if it contains reserved URL characters.
DOCPILOT_REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379/0
# Required in production. This is the shared public API budget; it uses
# DOCPILOT_REDIS_URL unless DOCPILOT_RATE_LIMIT_STORAGE_URI is explicitly set.
DOCPILOT_RATE_LIMIT=1000/minute
# Required in production. This is a hard per-workspace ceiling for every
# platform-funded LLM call. Workspace owners may lower it but cannot exceed it.
# Use 0 as an emergency kill switch for platform-funded AI; never leave it blank.
DOCPILOT_OFFICIAL_MONTHLY_TOKEN_CEILING=
# Required in production. Add only the direct IP/CIDR that the API sees for
# your 1Panel/OpenResty proxy path (often the Docker bridge gateway), never
# arbitrary public networks. See docs/ops/vps-pilot-deployment.md.
DOCPILOT_TRUSTED_PROXY_CIDRS=
DOCPILOT_MINIO_ENDPOINT=minio:9000
DOCPILOT_MINIO_ACCESS_KEY=replace-with-a-non-default-access-key
DOCPILOT_MINIO_SECRET_KEY=replace-with-a-long-random-storage-secret
DOCPILOT_JWT_SECRET=replace-with-a-long-random-jwt-secret
DOCPILOT_SECRETS_KEY=replace-with-a-valid-fernet-key
DOCPILOT_APP_URL=https://bidpilot.rglens.com
DOCPILOT_API_URL=https://bidpilot-api.rglens.com
DOCPILOT_CORS_ORIGINS=https://bidpilot.rglens.com
DOCPILOT_ENV=production
DOCPILOT_AUTH_REQUIRED=true
DOCPILOT_LANGGRAPH_CHECKPOINTER=postgres
DOCPILOT_AGENT_CHECKPOINTER=postgres
DOCPILOT_ASSISTANT_ENGINE=pi
DOCPILOT_PI_AGENT_URL=http://pi-agent:8787
DOCPILOT_PI_TOOL_BRIDGE_URL=http://api:8000/internal/pi/tools/execute
# Dedicated run-scoped bridge secret; do not reuse the JWT secret in production.
DOCPILOT_PI_INTERNAL_SECRET=replace-with-a-dedicated-random-pi-bridge-secret
DOCPILOT_INTERNAL_UNLIMITED_USAGE=false
USE_LANGGRAPH=true
DOCPILOT_ALLOW_STUB_LLM=false
# Configure exactly one platform assistant provider. The values stay in the
# server-side .env file and are never built into the web image.
DOCPILOT_ASSISTANT_PROTOCOL=openai
DOCPILOT_ASSISTANT_PROVIDER_ID=opencode-go
DOCPILOT_ASSISTANT_API_KEY=replace-with-provider-key
DOCPILOT_ASSISTANT_BASE_URL=https://opencode.ai/zen/go/v1
DOCPILOT_ASSISTANT_MODEL=deepseek-v4-flash
# Alternative platform profile: OPENCODE_API_KEY=replace-with-provider-key
DOCPILOT_SMTP_HOST=replace-with-smtp-host
DOCPILOT_SMTP_USER=replace-with-smtp-user
DOCPILOT_SMTP_PASS=replace-with-smtp-app-password
DOCPILOT_SMTP_FROM=replace-with-from-address
DOCPILOT_SMTP_FROM_NAME=BidPilot
# Resend is preferred over SMTP when both are configured. Keep this sender on
# a domain verified in the Resend account.
RESEND_API_KEY=replace-with-resend-api-key
DOCPILOT_RESEND_FROM=BidPilot <notifications@updates.rglens.com>
DOCPILOT_PROVIDER_DOMESTIC_API_KEY=replace-with-provider-key
DOCPILOT_PROVIDER_DOMESTIC_MODEL=replace-with-provider-model-name
# Platform embeddings use the same server-only configuration contract in API
# and Worker. Qwen3 Embedding supports this 1536-dimensional projection.
DOCPILOT_EMBEDDING_API_KEY=replace-with-embedding-provider-key
DOCPILOT_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
DOCPILOT_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
DOCPILOT_EMBEDDING_DIMENSIONS=1536
DOCPILOT_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
# Optional until paid self-serve is enabled. Keep all Stripe values server-side;
# VITE_* must never contain a Stripe secret, webhook secret, or price ID.
DOCPILOT_STRIPE_SECRET_KEY=
DOCPILOT_STRIPE_WEBHOOK_SECRET=
DOCPILOT_STRIPE_PRO_PRICE_ID=
DOCPILOT_STRIPE_ENTERPRISE_PRICE_ID=
VITE_API_URL=https://bidpilot-api.rglens.com
VITE_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
