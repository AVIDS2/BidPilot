# DocPilot Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- SMTP ---
DOCPILOT_SMTP_HOST=smtp.qq.com
DOCPILOT_SMTP_PORT=465
DOCPILOT_SMTP_TLS=true
DOCPILOT_SMTP_USER=
DOCPILOT_SMTP_PASS=
DOCPILOT_SMTP_FROM=

# --- JWT ---
DOCPILOT_JWT_SECRET=change-me-in-production-at-least-32-characters-long!

# --- Secret encryption ---
# Generate with:
# uv run --directory services/api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCPILOT_SECRETS_KEY=

# --- App ---
DOCPILOT_APP_URL=http://localhost:5173
DOCPILOT_API_URL=http://localhost:8000
DOCPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Assistant runtime ---
# Pi is the only runtime for new assistant turns. The API remains the
# business-control plane; Pi never receives database credentials.
DOCPILOT_ASSISTANT_ENGINE=pi
DOCPILOT_PI_AGENT_URL=http://localhost:8787
DOCPILOT_PI_TOOL_BRIDGE_URL=http://localhost:8000/internal/pi/tools/execute
# Use a separate random secret in shared/production deployments.
DOCPILOT_PI_INTERNAL_SECRET=replace-with-a-dedicated-random-pi-bridge-secret

# --- Optional Mem0 Platform profile memory ---
DOCPILOT_MEM0_ENABLED=false
DOCPILOT_MEM0_API_KEY=
DOCPILOT_MEM0_HOST=https://api.mem0.ai
DOCPILOT_MEM0_AGENT_ID=bidpilot-assistant
DOCPILOT_MEM0_APP_SCOPE=true
DOCPILOT_MEM0_TIMEOUT_SECONDS=1.5

# --- Database ---
DATABASE_URL=postgresql+psycopg://docpilot:docpilot@localhost:5433/docpilot
DOCPILOT_DATABASE_URL=postgresql+psycopg://docpilot:docpilot@localhost:5433/docpilot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
DOCPILOT_REDIS_URL=redis://localhost:6379/0

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=docpilot
DOCPILOT_MINIO_ENDPOINT=localhost:9000
DOCPILOT_MINIO_ACCESS_KEY=docpilot
DOCPILOT_MINIO_SECRET_KEY=docpilot123

# --- Auth ---
DOCPILOT_AUTH_REQUIRED=true

# --- Provider (at least one required for production) ---
DOCPILOT_PROVIDER_OPENAI_API_KEY=
DOCPILOT_PROVIDER_DOMESTIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DOCPILOT_PROVIDER_DOMESTIC_API_KEY=
# Local compatibility aliases for Aliyun Bailian/DashScope keys.
# Prefer DOCPILOT_PROVIDER_DOMESTIC_API_KEY in shared deployments.
ALIYUN_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# --- LangGraph ---
# postgres = durable checkpoints; memory = local smoke tests only.
DOCPILOT_LANGGRAPH_CHECKPOINTER=postgres
